{
  "name": "rtr-bench",
  "version": "0.1.1",
  "description": "Can a language model predict how a crowd reads a word? A cultural fluency benchmark built from Mixed Messages.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1999labs/RTR-bench.git"
  },
  "homepage": "https://github.com/1999labs/RTR-bench",
  "keywords": [
    "benchmark",
    "llm",
    "evaluation",
    "cultural-fluency",
    "generative-art"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "rtr-bench": "dist/cli.js"
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:node:*",
    "prepack": "npm run build",
    "export": "node scripts/export.mjs",
    "run": "node src/cli.ts run",
    "score": "node src/cli.ts score",
    "report": "node src/cli.ts report",
    "mock": "node scripts/mock.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postgres": "^3.4.5",
    "viem": "^2.21.0"
  }
}
