{
  "name": "rtr-bench",
  "version": "0.2.2",
  "description": "Can a language model predict how a crowd reads a word? A cultural fluency benchmark built from Mixed Messages.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1999labs/RTR-bench.git"
  },
  "homepage": "https://github.com/1999labs/RTR-bench",
  "keywords": [
    "benchmark",
    "llm",
    "evaluation",
    "cultural-fluency",
    "generative-art"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "rtr-bench": "dist/cli.js"
  },
  "files": [
    "dist/",
    "data/",
    "docs/distribution.md",
    "docs/learn-room.md",
    "docs/npm-release.md",
    "docs/preflight-audit.md",
    "docs/preflight-providers-2026-11-14.json",
    "tests/fixtures/distribution-pilot.json",
    "tests/fixtures/learn-room-pilot.json",
    "tests/fixtures/learn-room-four-strategies.json",
    "README.md",
    "LICENSE",
    "docs/development-pilot-2026-11-14.json",
    "docs/final-run-plan-8000.md",
    "docs/final-run-plan-8000.json",
    "results/predict-scatter.png",
    "results/learn-scatter.png",
    "results/predict-learn-scatter.png",
    "results/predict-learn-scatter.json",
    "results/final-8000/README.md",
    "results/final-8000/verified-results.json",
    "docs/final-campaign-shared-budget.json",
    "docs/final-campaign-price-amendment.json",
    "docs/final-campaign-provider-amendment.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts tests/distribution/*.test.ts tests/learn-room/*.test.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:node:*",
    "prepack": "npm run build",
    "export": "node scripts/export.mjs",
    "run": "node src/cli.ts run",
    "score": "node src/cli.ts score",
    "report": "node src/cli.ts report",
    "mock": "node scripts/mock.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postgres": "^3.4.5",
    "viem": "^2.21.0"
  }
}
